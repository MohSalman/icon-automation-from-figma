# Copy to .env (gitignored) for local runs of `npm run figma:export`.
# In CI, set these as GitHub Actions repository secrets instead
# (repo Settings > Secrets and variables > Actions).

# Figma Personal Access Token — Figma account settings > Personal access tokens.
FIGMA_TOKEN=

# The file key from your Figma file's URL:
# https://www.figma.com/file/<FIGMA_FILE_KEY>/...
FIGMA_FILE_KEY=

# npmjs.org auth token (an "Automation" token) used only by the CI publish step.
NPM_TOKEN=
