{
  "name": "icon-automation-from-figma",
  "version": "0.1.0",
  "description": "Tree-shakable React icon package generated from Figma via a CI pipeline.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "figma:export": "node scripts/export-from-figma.cjs",
    "build:catalog": "node scripts/build-catalog.cjs",
    "check:duplicates": "node scripts/check-duplicates.cjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:catalog && vite build && tsc --emitDeclarationOnly",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "release": "semantic-release"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@figma-export/cli": "^6.4.0",
    "@figma-export/core": "^6.4.0",
    "@figma-export/output-components-as-svgr": "^6.4.0",
    "@figma-export/utils": "^6.4.0",
    "@semantic-release/exec": "^7.1.0",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/react": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/react": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "fast-glob": "^3.3.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "semantic-release": "^25.0.5",
    "storybook": "^10.4.6",
    "typescript": "^5.9.0",
    "vite": "^5.4.0"
  }
}
